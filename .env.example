# Public site origin. Used for canonical URLs, sitemap and OG image resolution.
NEXT_PUBLIC_SITE_URL=https://jusic.co

# Analytics — not wired yet. See docs/OPEN_ITEMS.md #4.
# Fill exactly one of these once a provider is chosen.
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_GA4_ID=

# ---------------------------------------------------------------------------
# Database — Neon Postgres. Stores contact form submissions.
# The pooled connection string from the Neon console, or injected automatically
# by the Neon integration in the Vercel marketplace. Note the -pooler host:
#   postgresql://USER:PASSWORD@ep-<id>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Neon Auth (Managed Better Auth) — guards /admin.
# NEON_AUTH_BASE_URL is the Auth URL from the Auth → Configuration tab. It is a
# different host from DATABASE_URL — the .neonauth. subdomain, and no -pooler:
#   https://ep-<id>.neonauth.<region>.aws.neon.tech/neondb/auth
# The JWKS endpoint under that URL is not used here: the dashboard reads the
# session through the SDK rather than verifying JWTs itself. It is only needed
# if another service (or Postgres RLS) has to validate a Neon Auth token.
# NEON_AUTH_COOKIE_SECRET: openssl rand -base64 32 (must be 32+ characters)
#
# Two things are configured in the Neon console, not here — the app calls the
# endpoints but cannot enable them:
#
#   1. Google sign-in. Add Google as an OAuth provider under Auth and paste the
#      client ID and secret from the Google Cloud console. The authorised
#      redirect URI is on the Neon Auth host, not on jusic.co:
#        <NEON_AUTH_BASE_URL>/callback/google
#      The deployment's own URL has to be allowed as a callback target on the
#      Neon side too — the sign-in sends an absolute callbackURL back to this
#      origin, and Neon honours it only for an origin it trusts.
#
#   2. Password-reset email. /admin/forgot-password calls request-password-reset,
#      which answers 400 "Reset password isn't enabled" unless a sending address
#      is configured for the project — the form says so rather than telling the
#      admin to try again. Without it, /admin/sign-up (password chosen on the
#      spot) and Google are the ways in, and neither needs mail.
#
# Reset links return to <origin>/admin/reset-password, derived from the request
# host, so previews and localhost need no extra configuration.
# ---------------------------------------------------------------------------
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Who may open the dashboard, comma separated. Neon Auth lets anyone sign up;
# only addresses on the allowlist get past /admin — everyone else sees
# /admin/no-access.
#
# This is the ROOT half of that allowlist: it needs no database, cannot be
# edited from the browser, and is what gets the first person in and back in if
# the admin_allowlist table is ever emptied or unreachable. Keep at least one
# address here. Everyone added afterwards is a row in that table, managed from
# /admin/team — a click, no redeploy.
ADMIN_EMAILS=editor@jusic.co

# ---------------------------------------------------------------------------
# Make — new submissions are POSTed here. Optional: if the URL is unset the
# submission is still stored, it just is not forwarded.
#
# This is the env-configured destination and it is not the only one: every
# enabled row in the `webhooks` table gets the same JSON, added and tested from
# /admin/webhooks without a redeploy. Keep this one for the Make scenario that
# predates that screen.
# MAKE_WEBHOOK_SECRET signs the body as x-jusic-signature (HMAC-SHA256, hex)
# so the scenario can verify the request really came from the site.
# ---------------------------------------------------------------------------
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=

# Salt for hashing submitter IPs. Any long random string; changing it resets
# rate limiting. The raw IP is never written to the database.
IP_HASH_SALT=
