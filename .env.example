# Public site origin. Used for canonical URLs, sitemap and OG image resolution.
NEXT_PUBLIC_SITE_URL=https://jusic.co

# Analytics — not wired yet. See docs/OPEN_ITEMS.md #4.
# Fill exactly one of these once a provider is chosen.
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_GA4_ID=

# ---------------------------------------------------------------------------
# Database — Neon Postgres. Stores contact form submissions.
# The pooled connection string from the Neon console, or injected automatically
# by the Neon integration in the Vercel marketplace.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Neon Auth (Managed Better Auth) — guards /admin.
# NEON_AUTH_BASE_URL comes from the Auth → Configuration tab in the Neon console.
# NEON_AUTH_COOKIE_SECRET: openssl rand -base64 32
# ---------------------------------------------------------------------------
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Who may open the dashboard, comma separated. Neon Auth lets anyone sign up;
# only addresses listed here get past /admin. Everyone else sees /admin/no-access.
ADMIN_EMAILS=editor@jusic.co

# ---------------------------------------------------------------------------
# Make — new submissions are POSTed here. Optional: if the URL is unset the
# submission is still stored, it just is not forwarded.
# MAKE_WEBHOOK_SECRET signs the body as x-jusic-signature (HMAC-SHA256, hex)
# so the scenario can verify the request really came from the site.
# ---------------------------------------------------------------------------
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=

# Salt for hashing submitter IPs. Any long random string; changing it resets
# rate limiting. The raw IP is never written to the database.
IP_HASH_SALT=
